{
  "name": "@tealbrick/ui",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:gallery": "vite --config gallery/vite.config.ts",
    "build:gallery": "tsc --noEmit && vite build --config gallery/vite.config.ts",
    "check": "tsc --noEmit && node --test test/*.test.mjs"
  },
  "exports": {
    ".": "./src/index.tsx",
    "./tokens.css": "./src/tokens.css",
    "./components.css": "./src/components.css",
    "./fleet.css": "./src/fleet.css",
    "./brand-spec": "./brand-spec.md",
    "./mark.svg": "./assets/tealbrick-mark.svg",
    "./mark.png": "./assets/tealbrick-mark.png",
    "./vite": "./vite/app-icons.mjs"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/node": "24.12.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vite": "8.2.1"
  }
}
