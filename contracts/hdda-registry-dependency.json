{
  "version": "doppelganger.marketplace.hdda-registry-dependency.v1",
  "authority": "doppelganger-registry",
  "host": {
    "entry": "Capabilities",
    "tabs": ["Skills", "Plugins", "Extensions"],
    "projection": {
      "registryUnitField": "capabilityProjection",
      "gatewayPluginId": "doppelganger-registry",
      "recordsPath": "/api/plugins/doppelganger-registry/proxy/marketplace/api/plugins/marketplace-hub/records",
      "recordSchema": "doppelganger.marketplace.capabilities-host.v1",
      "authenticated": true,
      "hostOwnsRendering": true,
      "hostOwnsTabs": true,
      "modalOwnership": "host-generic",
      "duplicateOwnership": "fail-closed",
      "tabReplacement": "forbidden"
    },
    "kernelContributions": {
      "records": {
        "type": "capability-record",
        "region": "app.capabilities.records"
      },
      "settings": {
        "type": "capability-settings-surface",
        "region": "app.capabilities.settings",
        "schemaVersion": "doppelganger.capability-settings.v1"
      }
    },
    "lifecycleOwnership": {
      "canonical": "marketplace",
      "directHermesRole": "underlying-adapters-only",
      "normalModeDirectHermesControls": false,
      "duplicateLifecycleControls": "forbidden"
    }
  },
  "api": {
    "snapshot": {
      "method": "GET",
      "path": "/api/plugins/doppelganger-registry/snapshot"
    },
    "currentWholeDocumentWrite": {
      "method": "PUT",
      "path": "/api/plugins/doppelganger-registry/registry",
      "marketplaceMayCall": false
    },
    "candidateUnitEnablement": {
      "owner": "hdda-primary-desktop-lane",
      "method": "PUT",
      "pathTemplate": "/api/plugins/doppelganger-registry/units/{unit_id}/enabled",
      "request": { "enabled": "boolean" },
      "success": {
        "ok": "boolean",
        "unit": "RegistryUnit",
        "snapshot": "RegistrySnapshot"
      },
      "errors": {
        "400": "invalid request JSON or enabled is not boolean",
        "404": "unknown unit",
        "409": "required unit, malformed registry, or unavailable registry conflict",
        "500": "atomic registry update failed"
      },
      "semantics": [
        "lock-protected",
        "atomic-write",
        "preserves-unrelated-raw-registry-fields-and-units"
      ],
      "status": "pending-hdda-pr-8"
    },
    "capabilitiesProjection": {
      "method": "GET",
      "pathFromRegistryUnit": "capabilityProjection.recordsPath",
      "gatewayPluginIdFromRegistryUnit": "capabilityProjection.gatewayPluginId",
      "authenticated": true,
      "schema": "doppelganger.marketplace.capabilities-host.v1"
    }
  },
  "unitMutation": {
    "owner": "hdda-primary-desktop-lane",
    "marketplaceWritesRegistry": false,
    "requiredPolicy": "required-units-cannot-disable-or-uninstall",
    "hubEnablementOperations": ["enable-unit", "disable-unit"]
  },
  "auth": {
    "owner": "hdda-host-sdk",
    "externalAuthScope": "auth",
    "status": "permissioned-hdda-dependency"
  }
}
