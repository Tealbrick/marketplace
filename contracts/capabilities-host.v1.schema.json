{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doppelganger.marketplace.capabilities-host.v1",
  "title": "Marketplace normalized response for the HDDA Capabilities host",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pluginRecords",
    "extensionRecords",
    "actions",
    "settingsSurfaces",
    "host"
  ],
  "properties": {
    "pluginRecords": {
      "type": "array",
      "items": { "$ref": "doppelganger.marketplace.plugin-record.v1" }
    },
    "extensionRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "recordId",
          "providerId",
          "ownerPluginId",
          "displayName",
          "description",
          "visible",
          "enabled",
          "required",
          "status",
          "capabilities"
        ],
        "properties": {
          "recordId": { "type": "string", "pattern": "^extension:" },
          "providerId": { "type": "string", "minLength": 1 },
          "ownerPluginId": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "visible": { "type": "boolean" },
          "enabled": { "type": "boolean" },
          "required": { "type": "boolean" },
          "status": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "detail"],
            "properties": {
              "state": {
                "enum": [
                  "disconnected",
                  "connecting",
                  "connected",
                  "auth-required",
                  "error"
                ]
              },
              "detail": { "type": "string" }
            }
          },
          "settingsSurfaceId": { "type": "string", "minLength": 1 },
          "capabilities": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actionId",
          "ownerRecordId",
          "operation",
          "label",
          "endpoint",
          "method"
        ],
        "properties": {
          "actionId": { "type": "string", "minLength": 1 },
          "ownerRecordId": { "type": "string", "minLength": 1 },
          "operation": {
            "enum": [
              "install",
              "enable",
              "disable",
              "configure",
              "update",
              "reload",
              "uninstall",
              "delete",
              "authenticate",
              "open-settings"
            ]
          },
          "label": { "type": "string", "minLength": 1 },
          "endpoint": {
            "type": "string",
            "pattern": "^/api/plugins/marketplace-hub/"
          },
          "method": { "enum": ["DELETE", "GET", "PATCH", "POST", "PUT"] },
          "payload": { "type": "object" },
          "destructive": { "type": "boolean" }
        }
      }
    },
    "settingsSurfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "settingsSurfaceId",
          "ownerRecordId",
          "schemaVersion",
          "presentation",
          "title",
          "jsonSchema",
          "allowedActions"
        ],
        "properties": {
          "settingsSurfaceId": { "type": "string", "minLength": 1 },
          "ownerRecordId": { "type": "string", "minLength": 1 },
          "schemaVersion": { "const": "doppelganger.capability-settings.v1" },
          "presentation": { "const": "modal" },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "jsonSchema": { "type": "object" },
          "uiSchema": { "type": "object" },
          "loadActionId": { "type": "string", "minLength": 1 },
          "submitActionId": { "type": "string", "minLength": 1 },
          "applyMode": {
            "enum": ["live", "reload-required", "restart-required"]
          },
          "allowedActions": { "type": "array" }
        }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "tabs", "lifecycleAuthority", "directHermesRole"],
      "properties": {
        "entry": { "const": "capabilities" },
        "tabs": { "const": ["skills", "plugins", "extensions"] },
        "lifecycleAuthority": { "const": "marketplace" },
        "directHermesRole": { "const": "underlying-adapters-only" }
      }
    }
  }
}
