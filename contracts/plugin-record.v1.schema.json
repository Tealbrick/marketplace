{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doppelganger.marketplace.plugin-record.v1",
  "title": "Doppelganger Marketplace Plugin Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "providerId",
    "pluginId",
    "displayName",
    "description",
    "version",
    "kind",
    "lifecycle",
    "enabled",
    "required",
    "connection",
    "contributions",
    "adapter",
    "capabilities",
    "actions",
    "allowedActions",
    "settingsSurfaceIds",
    "registry",
    "custom",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": "doppelganger.marketplace.plugin-record.v1" },
    "recordId": { "type": "string", "pattern": "^plugin:" },
    "providerId": { "const": "marketplace" },
    "pluginId": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "iconUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "version": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["native", "mcp"] },
    "lifecycle": {
      "enum": ["available", "installing", "installed", "error", "uninstalling"]
    },
    "enabled": { "type": "boolean" },
    "required": { "type": "boolean" },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "detail"],
      "properties": {
        "state": {
          "enum": [
            "disconnected",
            "connecting",
            "connected",
            "auth-required",
            "error"
          ]
        },
        "detail": { "type": "string" }
      }
    },
    "contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label", "mount", "routeSegment", "enabled"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "const": "extension-surface" },
          "label": { "type": "string", "minLength": 1 },
          "mount": {
            "enum": ["workspace", "right-rail", "settings-panel", "overlay"]
          },
          "routeSegment": { "type": "string", "minLength": 1 },
          "region": { "type": "string", "minLength": 1 },
          "minHostSdk": { "type": "string", "minLength": 1 },
          "settings": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "settingsSurfaceId": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 },
              "schema": { "type": "object" },
              "uiSchema": { "type": "object" }
            }
          },
          "enabled": { "type": "boolean" }
        }
      }
    },
    "adapter": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "native"],
          "properties": {
            "type": { "const": "native" },
            "native": {
              "type": "object",
              "required": ["provider", "runtimeSources"],
              "properties": {
                "provider": { "type": "string", "minLength": 1 },
                "runtimeSources": { "type": "array" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "mcp"],
          "properties": {
            "type": { "const": "mcp" },
            "mcp": {
              "type": "object",
              "additionalProperties": false,
              "required": ["transport", "config"],
              "properties": {
                "transport": { "enum": ["stdio", "sse", "streamable-http"] },
                "command": { "type": "string", "minLength": 1 },
                "args": { "type": "array", "items": { "type": "string" } },
                "url": { "type": "string", "format": "uri" },
                "cwd": { "type": "string", "minLength": 1 },
                "env": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                },
                "headers": {
                  "type": "object",
                  "additionalProperties": { "type": "string" }
                },
                "config": { "type": "object" }
              }
            }
          }
        }
      ]
    },
    "capabilities": { "type": "array", "items": { "type": "string" } },
    "actions": { "type": "array", "items": { "type": "string" } },
    "allowedActions": {
      "type": "array",
      "items": {
        "enum": [
          "install",
          "enable",
          "disable",
          "configure",
          "update",
          "reload",
          "uninstall",
          "delete",
          "authenticate"
        ]
      }
    },
    "settingsSurfaceIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "unitId", "contributionIds"],
      "properties": {
        "authority": { "const": "doppelganger-registry" },
        "unitId": { "type": "string", "minLength": 1 },
        "contributionIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "custom": { "type": "boolean" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
