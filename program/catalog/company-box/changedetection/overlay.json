    "/tag/{uuid}": {
      "get": {
        "parameters": [
          {
            "description": "Tag unique ID",
            "in": "path",
            "name": "uuid",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ]
      }
    }
  }
