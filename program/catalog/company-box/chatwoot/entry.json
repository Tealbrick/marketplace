  "exposure": "auto",
  "excluded": [
    {
      "operation": "getConversationMessages",
      "reason": "Not a real route: the upstream swagger lists it as /accounts/{account_id}/conversations/{conversation_id}/messages without the /api/v1 prefix, and Rails routes it only under /api/v1 (listed as list-all-messages). The call would 404."
    },
    {
      "operation": "get-sso-url-of-a-user",
      "reason": "Mints a one-time login URL that signs in as any user. A GET is a read grant, so it would let a read-only agent impersonate users; create SSO links from the Super Admin console instead."
    }
  ]
