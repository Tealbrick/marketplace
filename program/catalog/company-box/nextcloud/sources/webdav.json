    "/remote.php/dav/files/{user}/{path}": {
      "parameters": [
        {
          "name": "user",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "The Nextcloud user id whose storage is addressed; use the connector's own user."
