        {
          "name": "path",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "x-multi-segment": true,
          "description": "Path below the user's root, e.g. `Documents/Q3 report/notes.md`. Segments are encoded for you."
