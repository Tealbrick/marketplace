          "files"
        ],
        "externalDocs": {
          "description": "Nextcloud developer manual",
          "url": "https://docs.nextcloud.com/server/31/developer_manual/client_apis/WebDAV/basic.html"
        },
        "parameters": [
          {
            "name": "Depth",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "1"
            },
            "description": "0 = the item itself, 1 = the item and its children. infinity is normally refused by the server."
          }
        ],
        "requestBody": {
          "required": false,
          "description": "Optional PROPFIND request body (`<d:propfind>` with the requested properties); omit for all properties.",
          "content": {
            "application/xml": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "207": {
            "description": "Multistatus XML",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "x-report": {
        "operationId": "webdav-files-search-report",
        "summary": "Search files by favorite or system tag (REPORT oc:filter-files)",
        "tags": [
          "files"
        ],
        "externalDocs": {
          "description": "Nextcloud developer manual",
          "url": "https://docs.nextcloud.com/server/31/developer_manual/client_apis/WebDAV/search.html"
        },
        "requestBody": {
          "required": true,
          "description": "`<oc:filter-files>` with `<oc:filter-rules>` (e.g. `<oc:favorite>1</oc:favorite>` or `<oc:systemtag>`) and the properties to return.",
          "content": {
            "application/xml": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "207": {
            "description": "Multistatus XML",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "description": "Files filtered by favorite flag or system tag. Free-text SEARCH (DASL) is not available in this connector."
      }
