{
  "paths": {
    "/public/v1/posts": {
      "post": {
        "description": "Create, schedule or publish posts. Supplemented request body: the instance Swagger declares none because the controller takes an untyped body. Fields follow the Postiz public API docs; extra fields pass through to the app.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "description": "Post request. `type` is draft, schedule or now; `date` is ISO 8601; `posts` holds one entry per channel with its content.",
                "required": [
                  "type",
                  "posts"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "draft",
                      "schedule",
                      "now"
                    ]
                  },
                  "date": {
                    "type": "string",
                    "description": "ISO 8601 date-time to publish at."
                  },
                  "shortLink": {
                    "type": "boolean"
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "posts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          }
        },
        "x-company-box-supplement": true
      },
      "get": {
        "parameters": [
          {
            "name": "startDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "ISO 8601 start of the window."
          },
          {
            "name": "endDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "ISO 8601 end of the window."
          },
          {
            "name": "customer",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Customer id to filter by."
          }
        ],
        "description": "List posts in a date window. Supplemented query parameters: the instance Swagger declares none because the controller takes an untyped query.",
        "x-company-box-supplement": true
      }
    },
    "/public/v1/upload": {
      "post": {
        "description": "Upload a media file. Supplemented request body: the instance Swagger declares none because the controller reads the multipart upload directly.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "x-company-box-supplement": true
      }
    },
    "/public/v1/posts/{id}/release-id": {
      "put": {
        "description": "Set the network release id of a post. Supplemented request body (untyped upstream); expects a `releaseId`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "description": "Release update. Carries `releaseId`.",
                "properties": {
                  "releaseId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "x-company-box-supplement": true
      }
    },
    "/public/v1/integration-trigger/{id}": {
      "post": {
        "description": "Run a provider helper function for a channel. Supplemented request body (untyped upstream); the shape depends on the provider tool, normally `methodName` and `data`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true,
                "description": "Provider helper call.",
                "properties": {
                  "methodName": {
                    "type": "string"
                  },
                  "data": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        },
        "x-company-box-supplement": true
      }
    }
  }
}
