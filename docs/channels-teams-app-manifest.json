{
  "$schema": "https://developer.microsoft.com/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "1.0.0",
  "id": "<NEW-GUID-FOR-THIS-TEAMS-APP>",
  "developer": {
    "name": "<Your organization>",
    "websiteUrl": "https://<your-website>",
    "privacyUrl": "https://<your-website>/privacy",
    "termsOfUseUrl": "https://<your-website>/terms"
  },
  "name": {
    "short": "Marketplace Agents",
    "full": "Teal Brick Marketplace agents"
  },
  "description": {
    "short": "Posts approved agent messages to Teams.",
    "full": "Teal Brick Marketplace posts messages that your agents write, after you approve them or under a standing grant you set. Approvals happen in Teal Brick, never in Teams."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#0F766E",
  "bots": [
    {
      "botId": "<MICROSOFT-APP-ID>",
      "scopes": ["team", "groupChat", "personal"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "validDomains": [],
  "webApplicationInfo": {
    "id": "<MICROSOFT-APP-ID>",
    "resource": "https://RscBasedStoreApp"
  },
  "authorization": {
    "permissions": {
      "resourceSpecific": [
        { "name": "ChannelMessage.Read.Group", "type": "Application" },
        { "name": "ChatMessage.Read.Chat", "type": "Application" }
      ]
    }
  }
}
