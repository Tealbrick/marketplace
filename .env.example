# Local-only example. Replace every token with a disposable synthetic value.
MARKETPLACE_HOST=127.0.0.1
MARKETPLACE_PORT=5314
MARKETPLACE_DATA_DIR=./.local-data
MARKETPLACE_OPERATOR_ACCESS_TOKEN=replace-with-a-local-token-at-least-16-chars
MARKETPLACE_OPERATOR_ID=operator-local
MARKETPLACE_ORGANIZATION_ID=organization-local
MARKETPLACE_INTERNAL_AUTH_TOKEN=replace-with-a-service-token-at-least-16-chars
MARKETPLACE_ALLOWED_ORIGINS=http://127.0.0.1:5314
MARKETPLACE_PUBLIC_ORIGIN=http://127.0.0.1:5314
# Generate one unique 32-byte base64url or 64-character hex value per instance;
# keep it in the deployment secret store, never in the database or its backup.
MARKETPLACE_HANDOFF_ENCRYPTION_KEY=
# Example generator (store the output in your secret manager; do not commit it):
# node -e 'process.stdout.write(require("node:crypto").randomBytes(32).toString("hex"))'

# Optional governed dependencies. Leave unset for credential-free local tests.
# Rules is optional: without RULES_* Marketplace runs in owner approval mode
# (the operator session approves changes; agents need Portal consent). Only set
# RULES_* when a Rules miniapp is deployed for this workspace; once set, a
# down or misconfigured Rules service fails closed.
# RULES_BASE_URL=http://127.0.0.1:5313
# RULES_INTERNAL_AUTH_TOKEN=replace-with-a-rules-evaluation-token
# COMPOSIO_API_KEY=replace-with-a-disposable-provider-key
# COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3.1
# Test fixtures only: exact origins (http allowed) that bypass the custom MCP
# connector URL policy. Leave unset in every real deployment.
# MARKETPLACE_MCP_ALLOWED_ORIGINS=http://127.0.0.1:9000
