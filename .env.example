# Local-only example. Replace every token with a disposable synthetic value.
MARKETPLACE_HOST=127.0.0.1
MARKETPLACE_PORT=5314
MARKETPLACE_DATA_DIR=./.local-data
MARKETPLACE_OPERATOR_ACCESS_TOKEN=replace-with-a-local-token-at-least-16-chars
MARKETPLACE_OPERATOR_ID=operator-local
MARKETPLACE_ORGANIZATION_ID=organization-local
MARKETPLACE_INTERNAL_AUTH_TOKEN=replace-with-a-service-token-at-least-16-chars
MARKETPLACE_ALLOWED_ORIGINS=http://127.0.0.1:5314
MARKETPLACE_PUBLIC_ORIGIN=http://127.0.0.1:5314

# Optional governed dependencies. Leave unset for credential-free local tests.
# RULES_BASE_URL=http://127.0.0.1:5313
# RULES_INTERNAL_AUTH_TOKEN=replace-with-a-rules-evaluation-token
# COMPOSIO_API_KEY=replace-with-a-disposable-provider-key
# COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3.1
